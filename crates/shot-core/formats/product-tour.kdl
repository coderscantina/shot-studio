prompter full-script
pacing tight
layouts window
captions clean
auto-cut confidence=85 {
    silence on=#true min=600_000
    retake on=#true
    misspoken on=#true
    pause on=#true min=1_000_000
    filler on=#true
    idle-screen on=#true min=3_000_000
}
auto-zoom click typing scale=160 hold=1_500_000
zoom-motion smooth
cursor size=140 smoothing=120_000 ripple=#true
keystrokes shortcuts
window padding=64 corners=12 shadow=soft background="#141821" frame=none
on silence min=600_000 {
    cut breath=50_000 confidence=85
}
on pause min=1_000_000 {
    cut breath=50_000 confidence=85
}
on idle min=3_000_000 {
    cut breath=50_000 confidence=85
}
on filler {
    cut confidence=85
}
on retake {
    cut confidence=85
}
on misspoken {
    cut confidence=85
}
on emphasis {
    zoom 112 hold=1_000_000
}
on click {
    zoom 160 hold=1_000_000 lead=500_000
}
on typing {
    zoom 160 hold=1_000_000 lead=500_000
}
on url {
    overlay link-card for=6_000_000 {
        url
    }
}
on ocr {
    overlay highlight {
        text
        x
        y
        width
        height
    }
}
on idle min=8_000_000 {
    overlay b-roll
}
on marker label="B" {
    overlay b-roll for=4_000_000
}
